{
  "name": "freda-workspace-frontend",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --minify",
    "build:icons": "node scripts/build-icons.js",
    "build": "npm run build:css && npm run build:icons",
    "test": "node --test tests/*.test.js",
    "test:static": "node --test tests/static.test.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.1.1",
    "@fontsource-variable/manrope": "5.1.1",
    "jspdf": "^2.5.2",
    "lucide": "0.469.0",
    "playwright": "1.63.0",
    "qrcode-generator": "^1.4.4",
    "tailwindcss": "3.4.17"
  }
}
